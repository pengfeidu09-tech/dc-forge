# One-way custom bot configuration. This cannot receive chat messages.
WEBHOOK_URL=
SIGNING_SECRET=

# Two-way Feishu application bot configuration.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Set automatically by QR setup so a personal bot only accepts its creator by default.
FEISHU_ALLOWED_OPEN_ID=
# Comma-separated Feishu open_ids that may access internal knowledge and MCP tools.
FEISHU_INTERNAL_OPEN_IDS=
# Required only when using the optional HTTP callback endpoint.
FEISHU_VERIFICATION_TOKEN=
FEISHU_API_BASE_URL=https://open.feishu.cn
FEISHU_REQUIREMENT_SKILL_ID=automotive-procurement-v1
FEISHU_ENTERPRISE_PROJECT_ID=PRJ-TENDER-001
FEISHU_ENTERPRISE_USER_ID=user-procurement-owner
FEISHU_ENTERPRISE_AS_OF=2026-10-30T23:59:59+08:00

# Durable RequirementState directory. Must be outside this Git working tree.
REQUIREMENT_REPOSITORY_ROOT=

# QR setup and long connection:
# python -m backend.app.solution.feishu_setup setup --listen

# OpenAI-compatible LLM configuration (for example, DeepSeek).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
